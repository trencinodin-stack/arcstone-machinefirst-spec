{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/trencinodin-stack/arcstone-machinefirst-spec/main/schemas/machinefirst-receipt-v0.1.schema.json",
  "title": "MACHINEFIRST Auditor Execution Receipt (v0.1)",
  "description": "Structured verification receipt emitted by independent auditors executing a repository's quick_check and negative_control.",
  "type": "object",
  "required": [
    "receipt_schema",
    "machinefirst_version",
    "subject_name",
    "subject_revision",
    "contract_commit",
    "contract_digest_sha256",
    "auditor_state",
    "executed_at_utc",
    "offline_enforced",
    "artifact_digests_verified",
    "quick_check_exit_code",
    "negative_control_passed",
    "claim_results"
  ],
  "additionalProperties": false,
  "properties": {
    "receipt_schema": {
      "const": "machinefirst-receipt-v0.1"
    },
    "machinefirst_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "subject_name": {
      "type": "string",
      "minLength": 1
    },
    "subject_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "contract_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "contract_digest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "auditor_state": {
      "type": "string",
      "enum": [
        "not_checked",
        "identity_checked",
        "reproduced_pass",
        "reproduced_fail",
        "blocked",
        "conflict"
      ]
    },
    "executed_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "toolchain_image_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "offline_enforced": {
      "type": "boolean"
    },
    "artifact_digests_verified": {
      "type": "boolean"
    },
    "quick_check_exit_code": {
      "type": "integer"
    },
    "negative_control_passed": {
      "type": "boolean"
    },
    "claim_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "status",
          "claimed_level"
        ],
        "additionalProperties": false,
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "not_checked",
              "identity_checked",
              "reproduced_pass",
              "reproduced_fail",
              "blocked",
              "conflict",
              "UNKNOWN",
              "UNVERIFIABLE"
            ]
          },
          "claimed_level": {
            "type": "string",
            "enum": [
              "proved",
              "tested",
              "measured",
              "static_analysis",
              "stated",
              "external_llm_review"
            ]
          },
          "observed_value": {},
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
